# ============================================
# Frontend (Vite) variables
# ============================================

# Supabase project URL (public, safe for frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL used by the frontend
VITE_API_URL=http://localhost:8000


# ============================================
# Backend variables
# ============================================

# Gemini API key used by FastAPI server
GEMINI_API_KEY=your-gemini-api-key

# Supabase project URL used by backend
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000